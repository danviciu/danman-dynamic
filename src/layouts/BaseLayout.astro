---
import { readdirSync } from "node:fs";
import { resolve } from "node:path";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = `${site.brandName} | Mobilier la comanda`,
  description = "Mobilier si proiecte din lemn masiv, realizate la comanda de DanMan.",
  canonicalPath = Astro.url.pathname,
  ogImage = "/img/placeholder.png",
  noIndex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site.domain).toString();
const pathname = Astro.url.pathname;
const socialEntries = Object.entries(site.social ?? {}).filter(([, url]) => Boolean(url));
const phoneHref = `tel:${site.phone.replace(/\s+/g, "")}`;

let logoPath = "/favicon.svg";

try {
  const imgDir = resolve(process.cwd(), "public", "img");
  const allFiles = readdirSync(imgDir, { withFileTypes: true }).filter((entry) => entry.isFile());
  const logoFiles = allFiles
    .map((entry) => entry.name)
    .filter((fileName) => /^logo-/i.test(fileName) && /\.(png|jpe?g|webp|avif|svg)$/i.test(fileName))
    .sort((a, b) => a.localeCompare(b, "ro", { sensitivity: "base" }));

  if (logoFiles.length > 0) {
    logoPath = `/img/${encodeURIComponent(logoFiles[0])}`;
  } else if (allFiles.some((entry) => entry.name.toLowerCase() === "placeholder.png")) {
    logoPath = "/img/placeholder.png";
  }
} catch {
  logoPath = "/favicon.svg";
}

const ogImagePath = ogImage.startsWith("/") ? ogImage : logoPath;
const ogImageUrl = new URL(ogImagePath, site.domain).toString();
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.brandName,
  url: site.domain,
  telephone: site.phone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Oituz 29",
    addressLocality: "Sacele",
    addressRegion: "Brasov",
    addressCountry: "RO",
  },
  sameAs: socialEntries.map(([, url]) => url),
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={logoPath} />
    <link rel="apple-touch-icon" href={logoPath} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <slot name="head" />
  </head>
 <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

  <body>
    <header class="site-header">
      <div class="container nav-row">
        <a class="brand" href="/">
          <img src={logoPath} alt={`${site.brandName} logo`} />
          <span>{site.brandName}</span>
        </a>
        <nav class="nav" aria-label="Navigatie principala">
          <a class={isActive("/") ? "active" : ""} href="/">Acasa</a>
          <a class={isActive("/produse") ? "active" : ""} href="/produse">Produse</a>
          <a class={isActive("/proiecte") ? "active" : ""} href="/proiecte">Proiecte</a>
          <a class={isActive("/contact") ? "active" : ""} href="/contact">Contact</a>
        </nav>
        <a class="cta-btn" href="/contact">Cere oferta</a>
      </div>
    </header>

    <main class="container main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h3>{site.brandName}</h3>
          <p>{site.address}</p>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div>
          <h4>Social</h4>
          {socialEntries.map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">{name}</a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap");

  :root {
    --bg: #f2eee6;
    --surface: #fffdf9;
    --text: #1f1b16;
    --muted: #5e544a;
    --line: #dbcbb5;
    --accent: #7e5432;
    --accent-2: #57381f;
    --radius: 16px;
    --shadow: 0 16px 34px rgba(34, 25, 16, 0.1);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Manrope", "Segoe UI", sans-serif;
    background: radial-gradient(circle at top, #faf6ee 0%, var(--bg) 44%, #ece4d7 100%);
    color: var(--text);
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: "Fraunces", Georgia, serif;
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .container {
    width: min(1150px, 92vw);
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-row {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand img {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--line);
    background: #fff;
  }

  .nav {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav a {
    color: var(--muted);
    font-weight: 600;
    padding: 0.3rem 0.45rem;
    border-bottom: 2px solid transparent;
  }

  .nav a.active,
  .nav a:hover {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .cta-btn {
    display: inline-flex;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.62rem 0.95rem;
    font-weight: 700;
    transition: background-color 160ms ease;
  }

  .cta-btn:hover {
    background: var(--accent-2);
  }

  .main-content {
    padding: 2.4rem 0 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    padding: 2rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .footer-grid h3,
  .footer-grid h4 {
    margin-bottom: 0.45rem;
  }

  .footer-grid a {
    display: block;
    color: var(--muted);
  }

  .section-title {
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    margin-bottom: 0.6rem;
  }

  .section-lead {
    max-width: 760px;
    margin-bottom: 1.2rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .card-content {
    padding: 1rem;
    display: grid;
    gap: 0.55rem;
  }

  .chip {
    display: inline-block;
    width: fit-content;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.58rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-2);
    background: #f9f2e8;
  }

  .link-arrow {
    color: var(--accent-2);
    font-weight: 700;
  }

  @media (max-width: 920px) {
    .nav-row {
      padding: 0.55rem 0;
      min-height: auto;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
