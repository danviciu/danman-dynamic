---
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import site from "../data/site.json";
import { absoluteImageUrl, toUrlPath } from "../utils/images";
import { addressText, businessSchema } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "product";
  noIndex?: boolean;
}

const {
  title = site.seo.defaultTitle,
  description = site.seo.defaultDescription,
  canonicalPath = Astro.url.pathname,
  ogImage = site.seo.ogImage,
  ogType = "website",
  noIndex = false,
} = Astro.props;

// Toate URL-urile canonice au slash final (la fel ca sitemap-ul si Netlify).
const normalizedPath = canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`;
const canonical = new URL(normalizedPath, site.domain).toString();
const pathname = Astro.url.pathname;
const ogImageUrl = absoluteImageUrl(ogImage, site.domain);
const logoUrl = toUrlPath(site.logo);
const phoneHref = `tel:${site.phone.replace(/[^\d+]/g, "")}`;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href.replace(/\/$/, ""));

// CSP pentru site-ul public (adminul are politica lui, vezi public/_headers).
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  "frame-src https://www.google.com https://maps.google.com",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href={logoUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#8b5e3c" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400..800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Material+Icons+Outlined&display=swap"
    />

    <JsonLd data={businessSchema()} />

    <script is:inline>
      // Token-urile Netlify Identity (invitatie/confirmare/resetare parola) ajung uneori
      // pe alte pagini; le trimitem catre /confirm/ unde sunt procesate.
      (function () {
        var h = window.location.hash || "";
        if (/(invite|confirmation|recovery|email_change)_token=/.test(h)) {
          window.location.replace("/confirm/" + h);
        }
        try {
          var stored = localStorage.getItem("danman-theme");
          var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <header class="site-header">
      <div class="container nav-row">
        <a class="brand" href="/" aria-label={`${site.brandName} – pagina principală`}>
          <span class="brand-mark" aria-hidden="true">{site.brandShort.charAt(0)}</span>
          <span class="brand-text">
            <span class="brand-name">{site.brandShort}</span>
            <span class="brand-sub">{site.brandTagline}</span>
          </span>
        </a>

        <button class="menu-toggle" id="menuToggle" type="button" aria-label="Deschide meniul" aria-expanded="false" aria-controls="mainNav">
          <span class="material-icons-outlined" aria-hidden="true">menu</span>
        </button>

        <nav class="nav" id="mainNav" aria-label="Navigație principală">
          {site.nav.map((item) => (
            <a class={isActive(item.href) ? "active" : undefined} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="Comută tema luminoasă/întunecată">
            <span class="material-icons-outlined icon-dark" aria-hidden="true">dark_mode</span>
            <span class="material-icons-outlined icon-light" aria-hidden="true">light_mode</span>
          </button>
          <a class="cta-btn" href={site.ctaHref}>{site.ctaLabel}</a>
        </div>
      </div>
    </header>

    <main class="container main-content" id="continut">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">{site.brandShort.charAt(0)}</span>
            <span class="brand-text">
              <span class="brand-name">{site.brandShort}</span>
              <span class="brand-sub">{site.brandTagline}</span>
            </span>
          </a>
          <p class="footer-about">{site.footerText}</p>
          <address class="footer-about">{addressText()}</address>
        </div>
        <div>
          <h2 class="footer-heading">Contact</h2>
          <a href={phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="footer-muted">{site.openingHoursText}</span>
        </div>
        <div>
          <h2 class="footer-heading">Social</h2>
          {site.social.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
          ))}
        </div>
      </div>
      <p class="container footer-copy">© {new Date().getFullYear()} {site.brandName}</p>
    </footer>

    <script>
      const themeToggle = document.getElementById("themeToggle");
      themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("danman-theme", isDark ? "dark" : "light");
        } catch {
          /* stocare indisponibila (mod privat) */
        }
      });

      const menuToggle = document.getElementById("menuToggle");
      const mainNav = document.getElementById("mainNav");
      menuToggle?.addEventListener("click", () => {
        const isOpen = mainNav?.classList.toggle("open") ?? false;
        menuToggle.setAttribute("aria-expanded", String(isOpen));
      });
    </script>
  </body>
</html>

<style>
  .footer-heading {
    margin-bottom: 0.6rem;
    font-family: "Plus Jakarta Sans", sans-serif;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text);
  }

  address {
    font-style: normal;
    margin-top: 0.5rem;
  }

  .footer-muted {
    display: block;
    color: var(--muted);
    padding: 0.15rem 0;
  }

  .footer-copy {
    margin-top: 1.6rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
