---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqList from "../../components/FaqList.astro";
import ProductCard from "../../components/ProductCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import pages from "../../data/pages.json";
import site from "../../data/site.json";
import { formatAmount, getProducts, getProjects, paragraphs } from "../../utils/catalog";
import { absoluteImageUrl } from "../../utils/images";
import { absoluteUrl } from "../../utils/seo";

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const data = product.entry.data;
const defaults = pages.productDefaults;

const [allProducts, allProjects] = await Promise.all([getProducts(), getProjects()]);
const related = allProducts
  .filter((p) => p.category.slug === product.category.slug && p.slug !== product.slug)
  .slice(0, 3);
const relatedProjects = allProjects.filter((p) => p.productSlugs.includes(product.slug)).slice(0, 3);

const faqs = data.faqs && data.faqs.length > 0 ? data.faqs : defaults.faqs;
const price = typeof data.price === "number" && data.price > 0 ? data.price : data.priceFrom;
const description = data.seoDesc || product.shortDesc;
const title = data.seoTitle || `${product.title} – ${product.category.name.toLowerCase()} din lemn masiv${site.seo.titleSuffix}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: product.shortDesc,
  image: product.images.map((image) => absoluteImageUrl(image, site.domain)),
  category: product.category.name,
  url: absoluteUrl(product.url),
  brand: { "@type": "Brand", name: site.brandName },
  ...(data.materials?.length ? { material: data.materials.join(", ") } : {}),
  ...(typeof price === "number"
    ? {
        offers: {
          "@type": "Offer",
          priceCurrency: "RON",
          price,
          availability: "https://schema.org/MadeToOrder",
          url: absoluteUrl(product.url),
          seller: { "@id": `${site.domain}/#business` },
        },
      }
    : {}),
};
---

<BaseLayout title={title} description={description} canonicalPath={product.url} ogImage={product.cover} ogType="product">
  <JsonLd slot="head" data={productSchema} />
  <Breadcrumbs
    items={[
      { label: "Produse", href: "/produse/" },
      { label: product.category.name, href: `/produse/${product.category.slug}/` },
      { label: product.title, href: product.url },
    ]}
  />

  <article class="product-layout">
    <Gallery images={product.images} title={product.title} />

    <section class="card info">
      <div class="card-content">
        <a class="chip" href={`/produse/${product.category.slug}/`}>{product.category.name}</a>
        <h1>{product.title}</h1>
        {data.shortDesc && <p class="lead">{product.shortDesc}</p>}

        <dl class="meta-grid">
          <div>
            <dt>Preț</dt>
            <dd><strong>{product.priceLabel}</strong></dd>
          </div>
          <div>
            <dt>Termen de execuție</dt>
            <dd><strong>{typeof data.leadTimeDays === "number" ? `${data.leadTimeDays} zile` : "La cerere"}</strong></dd>
          </div>
        </dl>

        <a class="cta-btn" href={`${site.ctaHref}?produs=${encodeURIComponent(product.title)}`}>{defaults.ctaLabel}</a>

        <div class="prose content-block">
          {paragraphs(data.longDesc).map((p) => <p>{p}</p>)}
        </div>

        {data.options && data.options.length > 0 && (
          <section class="content-block">
            <h2>Opțiuni disponibile</h2>
            {data.options.map((opt) => (
              <div class="option-group">
                <p class="option-name">{opt.nume}</p>
                <ul>
                  {opt.valori.map((v) => (
                    <li>
                      {v.nume}
                      {v.cost_add > 0 && ` (+${formatAmount(v.cost_add)} RON)`}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )}

        {data.benefits && data.benefits.length > 0 && (
          <section class="content-block">
            <h2>Avantaje</h2>
            <ul>{data.benefits.map((b) => <li>{b}</li>)}</ul>
          </section>
        )}

        {(data.materialsText || data.materials?.length || data.finishes?.length) && (
          <section class="content-block">
            <h2>Materiale și finisaje</h2>
            {data.materialsText && <p>{data.materialsText}</p>}
            {data.materials?.length ? <p><strong>Materiale:</strong> {data.materials.join(", ")}</p> : null}
            {data.finishes?.length ? <p><strong>Finisaje:</strong> {data.finishes.join(", ")}</p> : null}
          </section>
        )}

        {data.dimensionsText && (
          <section class="content-block">
            <h2>Dimensiuni</h2>
            <p>{data.dimensionsText}</p>
          </section>
        )}

        <section class="content-block">
          <h2>{defaults.customizationTitle}</h2>
          <p>{defaults.customization}</p>
        </section>

        <section class="content-block">
          <h2>Livrare și montaj</h2>
          <p>{data.shippingText || defaults.shipping}</p>
          {data.returnText && <p>{data.returnText}</p>}
        </section>

        <section class="content-block">
          <h2>Întreținere</h2>
          <p>{data.careText || defaults.care}</p>
        </section>

        <section class="content-block">
          <h2>{defaults.howWeWorkTitle}</h2>
          <ol>{defaults.howWeWork.map((step) => <li>{step}</li>)}</ol>
        </section>

        <div class="content-block">
          <FaqList items={faqs} />
        </div>
      </div>
    </section>
  </article>

  {relatedProjects.length > 0 && (
    <section class="section-block related">
      <h2 class="section-title">Proiecte realizate cu acest produs</h2>
      <div class="card-grid">{relatedProjects.map((p) => <ProjectCard project={p} headingLevel="h3" />)}</div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section-block related">
      <h2 class="section-title">Alte produse din categoria {product.category.name}</h2>
      <div class="card-grid">{related.map((p) => <ProductCard product={p} headingLevel="h3" />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  .product-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .info h1 {
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.4rem 0;
  }

  .meta-grid dt {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 700;
    color: var(--text);
  }

  .meta-grid dd {
    margin: 0.2rem 0 0;
    color: var(--accent);
  }

  .info .cta-btn {
    width: fit-content;
  }

  .content-block {
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }

  .content-block h2 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .option-group {
    margin-bottom: 0.6rem;
  }

  .option-name {
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  ul,
  ol {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .related {
    margin-top: 3rem;
  }

  @media (max-width: 920px) {
    .product-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
