---
const title = "Confirmare cont";
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <main class="confirm-box">
      <h1>Confirmare / Autentificare</h1>
      <p>Dacă nu se deschide automat, așteaptă 2-3 secunde. Se va deschide fereastra de confirmare/logare.</p>
    </main>

    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;

        function openIdentity() {
          var id = window.netlifyIdentity;
          if (!id) return false;
          try {
            if (typeof id.init === "function") id.init();
            if (typeof id.open === "function") id.open();
            id.on && id.on("login", function () {
              window.location.href = "/admin/";
            });
          } catch (e) {}
          return true;
        }

        if (openIdentity()) return;

        var tries = 0;
        var t = setInterval(function () {
          tries++;
          if (openIdentity() || tries >= 50) clearInterval(t);
        }, 100);
      })();
    </script>

    <style>
      .confirm-box {
        max-width: 720px;
        margin: 48px auto;
        padding: 0 16px;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      }
    </style>
  </body>
</html>
