---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getExistingImages, getOptimizedImageUrl, pickBestImage } from "../utils/catalog";

const PROJECT_FALLBACK_IMAGE = "/img/IMG_20250914_202642.webp";

const projects = (await getCollection("projects")).map((entry) => {
  const images = getExistingImages((entry.data.images ?? []).map((item) => item.image));
  const coverImage = pickBestImage(images, PROJECT_FALLBACK_IMAGE);

  return {
    title: entry.data.title,
    year: entry.data.year,
    location: entry.data.location || "Proiect personalizat",
    story: entry.data.story || entry.data.shortDesc || "Proiect realizat la comanda.",
    images: images.length > 0 ? images : [coverImage],
    coverImage,
  };
});

const photoHighlights = Array.from(new Set(projects.flatMap((project) => project.images))).slice(0, 6);
---

<BaseLayout
  title="Proiecte realizate | DanMan"
  description="Selectie de proiecte DanMan pentru locuinte si spatii comerciale din Romania."
  canonicalPath="/proiecte"
  ogImage={photoHighlights[0] ?? PROJECT_FALLBACK_IMAGE}
>
  <section class="intro">
    <h1 class="section-title">Proiecte</h1>
    <p class="section-lead">
      Lucrari livrate cu focus pe proportie, functionalitate si finisaj premium. Fiecare proiect este
      personalizat in functie de arhitectura spatiului si stilul clientului.
    </p>
  </section>

  {photoHighlights.length > 0 && (
    <section class="photo-strip">
      {photoHighlights.map((image, index) => (
        <img
          src={getOptimizedImageUrl(image, { width: 480, height: 290, quality: 70, fit: "cover" })}
          alt={`Lucrare DanMan ${index + 1}`}
          loading="lazy"
          decoding="async"
        />
      ))}
    </section>
  )}

  <section class="card-grid">
    {projects.map((project) => (
      <article class="card project-card">
        <img
          src={getOptimizedImageUrl(project.coverImage, { width: 760, height: 520, quality: 72, fit: "cover" })}
          alt={project.title}
          loading="lazy"
          decoding="async"
        />
        <div class="card-content">
          <div class="project-meta">
            <span class="chip">{project.location}</span>
            <span>{project.year ?? "An nedisponibil"}</span>
          </div>
          <h2>{project.title}</h2>
          <p>{project.story}</p>
          <a class="link-arrow" href="/contact">Discutam un proiect similar</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1.4rem;
  }

  .photo-strip {
    margin-bottom: 1.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.7rem;
  }

  .photo-strip img {
    width: 100%;
    height: 145px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .project-card h2 {
    font-size: 1.24rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: #665643;
    font-size: 0.9rem;
  }
</style>
