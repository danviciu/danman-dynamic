---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  getCategoryCoverImage,
  getExistingImages,
  getFallbackCategories,
  normalizeCategoryKey,
  pickBestImage,
} from "../utils/catalog";

const productsFromContent = (await getCollection("products")).map((entry) => {
  const images = getExistingImages((entry.data.images ?? []).map((item) => item.image));
  const categoryCover = getCategoryCoverImage(entry.data.category);

  return {
    slug: entry.slug,
    title: entry.data.title,
    category: entry.data.category,
    shortDesc: entry.data.shortDesc,
    priceFrom: entry.data.priceFrom,
    leadTimeDays: entry.data.leadTimeDays,
    coverImage: pickBestImage([...images, categoryCover]),
    href: `/produs/${entry.slug}`,
    ctaLabel: "Vezi produsul",
    sortOrder: 0,
  };
});

const existingCategoryKeys = new Set(
  productsFromContent.map((product) => normalizeCategoryKey(product.category)),
);

const fallbackCategoryProducts = getFallbackCategories(existingCategoryKeys).map((category) => ({
  slug: `categorie-${category.slug}`,
  title: `Categoria ${category.name}`,
  category: category.name,
  shortDesc: `${category.imageCount} imagini reale disponibile. Proiecte personalizate la comanda.`,
  priceFrom: undefined,
  leadTimeDays: undefined,
  coverImage: category.coverImage,
  href: `/contact?categorie=${encodeURIComponent(category.name)}`,
  ctaLabel: "Cere oferta",
  sortOrder: 1,
}));

const products = [...productsFromContent, ...fallbackCategoryProducts].sort(
  (a, b) =>
    a.sortOrder - b.sortOrder ||
    a.category.localeCompare(b.category, "ro", { sensitivity: "base" }) ||
    a.title.localeCompare(b.title, "ro", { sensitivity: "base" }),
);

const filterOptions = [
  "Toate",
  ...new Set(
    products
      .map((product) => product.category)
      .sort((a, b) => a.localeCompare(b, "ro", { sensitivity: "base" })),
  ),
];
---

<BaseLayout
  title="Produse | DanMan"
  description="Catalog DanMan generat din categoriile reale de imagini: mobilier, scari, usi, paturi, mese si altele."
  canonicalPath="/produse"
  ogImage={products[0]?.coverImage ?? "/img/IMG_20250914_202642.webp"}
>
  <section>
    <h1 class="section-title">Produse</h1>
    <p class="section-lead">
      Catalogul este generat din produsele CMS si din categoriile reale de imagini. Filtrezi rapid dupa
      categorie si cauti dupa nume sau descriere.
    </p>
  </section>

  <section class="filters card">
    <div class="search-row">
      <label for="searchInput">Cauta produse</label>
      <input id="searchInput" type="search" placeholder="Ex: paturi, usi, marchize..." />
    </div>
    <div class="buttons" id="categoryFilters">
      {filterOptions.map((name, index) => (
        <button type="button" class={index === 0 ? "active" : ""} data-category={name}>{name}</button>
      ))}
    </div>
    <p class="result-line">
      Rezultate: <strong id="resultCount">{products.length}</strong>
    </p>
  </section>

  <section class="card-grid" id="productsGrid">
    {products.map((product) => (
        <article
          class="card product-card"
          data-category={product.category}
          data-search={`${product.title} ${product.category} ${product.shortDesc}`.toLowerCase()}
        >
          {/* Public images are referenced from web root, e.g. /img/paturi/file.webp */}
          <img src={product.coverImage} alt={product.title} loading="lazy" />
          <div class="card-content">
            <span class="chip">{product.category}</span>
            <h2>{product.title}</h2>
            <p>{product.shortDesc}</p>
            <div class="meta">
              <span>
                {typeof product.priceFrom === "number"
                  ? `De la ${new Intl.NumberFormat("ro-RO").format(product.priceFrom)} RON`
                  : "Pret la cerere"}
              </span>
              <span>{typeof product.leadTimeDays === "number" ? `${product.leadTimeDays} zile` : "Termen la cerere"}</span>
            </div>
            <a class="link-arrow" href={product.href}>{product.ctaLabel}</a>
          </div>
        </article>
      ))}
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById("searchInput");
  const categoryFilters = document.getElementById("categoryFilters");
  const productsGrid = document.getElementById("productsGrid");
  const resultCount = document.getElementById("resultCount");

  let activeCategory = "Toate";

  const applyFilters = () => {
    if (!searchInput || !categoryFilters || !productsGrid || !resultCount) return;

    const query = searchInput.value.trim().toLowerCase();
    const cards = Array.from(productsGrid.querySelectorAll(".product-card"));
    let visible = 0;

    cards.forEach((card) => {
      const category = card.dataset.category || "";
      const searchText = card.dataset.search || "";
      const matchesCategory = activeCategory === "Toate" || category === activeCategory;
      const matchesSearch = searchText.includes(query);
      const shouldShow = matchesCategory && matchesSearch;
      card.hidden = !shouldShow;
      if (shouldShow) visible += 1;
    });

    resultCount.textContent = String(visible);
  };

  searchInput?.addEventListener("input", applyFilters);

  categoryFilters?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;

    activeCategory = target.dataset.category || "Toate";
    categoryFilters.querySelectorAll("button").forEach((button) => {
      button.classList.toggle("active", button === target);
    });
    applyFilters();
  });
</script>

<style>
  .filters {
    padding: 1rem;
    margin-bottom: 1.2rem;
    display: grid;
    gap: 0.85rem;
  }

  .search-row label {
    display: block;
    margin-bottom: 0.3rem;
    font-weight: 700;
    color: #564838;
  }

  .search-row input {
    width: min(560px, 100%);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.72rem 0.88rem;
    font: inherit;
    background: #fff;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .buttons button {
    border: 1px solid var(--line);
    background: #fff;
    color: var(--text);
    border-radius: 999px;
    padding: 0.46rem 0.75rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .buttons button.active {
    background: var(--accent-2);
    border-color: var(--accent-2);
    color: #fff;
  }

  .result-line {
    font-size: 0.95rem;
  }

  .product-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .product-card h2 {
    font-size: 1.28rem;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: #4f463c;
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
