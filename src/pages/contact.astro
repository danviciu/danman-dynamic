---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Img from "../components/Img.astro";
import pages from "../data/pages.json";
import site from "../data/site.json";
import { addressText } from "../utils/seo";

const page = pages.contact;
const phoneHref = `tel:${site.phone.replace(/[^\d+]/g, "")}`;
const whatsappHref = `https://wa.me/${(site.whatsapp || site.phone).replace(/[^\d]/g, "")}`;
const address = addressText();
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const [firstImage, ...otherImages] = page.images;
---

<BaseLayout title={page.seoTitle} description={page.seoDesc} canonicalPath="/contact/" ogImage={firstImage?.image}>
  <Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} />
  <PageIntro title={page.title} lead={page.lead} />

  <section class="contact-grid">
    <article class="card">
      <div class="card-content">
        <h2>{page.formTitle}</h2>
        <form id="contactForm" name="contact" method="POST" action="/contact/?trimis=1" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="subiect" id="subject" value="" />
          <p class="honeypot-field" aria-hidden="true">
            <label>Nu completa acest câmp: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label for="name">Nume</label>
          <input id="name" name="name" type="text" autocomplete="name" maxlength="120" required />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="160" required />

          <label for="phone">Telefon</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />

          <label for="message">Mesaj</label>
          <textarea id="message" name="message" rows="6" maxlength="4000" placeholder={page.messagePlaceholder} required></textarea>

          <p class="privacy-note">{page.privacyNote}</p>
          <button class="cta-btn" type="submit">{page.submitLabel}</button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite" data-success={page.successMessage}></p>
        </form>
      </div>
    </article>

    <article class="card">
      <div class="card-content">
        {firstImage && <Img class="contact-photo" src={firstImage.image} alt={firstImage.alt} sizes="(max-width: 860px) 100vw, 420px" />}
        <h2>{page.quickTitle}</h2>
        <a class="quick-link" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp: {site.phone}</a>
        <a class="quick-link" href={phoneHref}>Telefon: {site.phone}</a>
        <a class="quick-link" href={`mailto:${site.email}`}>Email: {site.email}</a>
        <p><strong>Atelier:</strong> {address}</p>
        <p><strong>Program:</strong> {site.openingHoursText}</p>
        <p><strong>Timp de răspuns:</strong> {site.responseTime}</p>
      </div>
    </article>
  </section>

  {otherImages.length > 0 && (
    <section class="contact-gallery" aria-label="Lucrări realizate">
      {otherImages.map((item) => (
        <figure class="card gallery-card">
          <Img src={item.image} alt={item.alt} sizes="(max-width: 700px) 100vw, 400px" />
        </figure>
      ))}
    </section>
  )}

  <section class="map-wrap">
    <iframe title={`Hartă: ${address}`} src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const status = document.getElementById("formStatus");
  const message = document.getElementById("message") as HTMLTextAreaElement | null;
  const subject = document.getElementById("subject") as HTMLInputElement | null;

  // Mesaj de confirmare dupa trimiterea formularului (Netlify Forms)
  if (status && params.get("trimis") === "1") {
    status.textContent = status.dataset.success ?? "";
    status.classList.add("is-success");
    params.delete("trimis");
  }

  // Precompletare din linkurile "Cere ofertă" de pe produse/categorii/proiecte
  const topic = params.get("produs") || params.get("categorie") || params.get("proiect");
  if (topic) {
    const clean = topic.slice(0, 120);
    if (subject) subject.value = clean;
    if (message && !message.value) message.value = `Bună ziua, aș dori o ofertă pentru: ${clean}.\n\n`;
  }

  if (window.location.search && params.toString() !== window.location.search.slice(1)) {
    const query = params.toString();
    window.history.replaceState({}, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-grid :global(.contact-photo) {
    width: 100%;
    height: 190px;
    object-fit: contain;
    background: var(--bg);
    border-radius: 12px;
    border: 1px solid var(--line);
    margin-bottom: 0.6rem;
  }

  form {
    display: grid;
    gap: 0.55rem;
  }

  label {
    font-weight: 700;
    color: var(--text);
  }

  input,
  textarea {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.7rem 0.8rem;
    font: inherit;
    background: var(--surface);
    color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  .privacy-note {
    font-size: 0.82rem;
  }

  .form-status {
    min-height: 1.6rem;
    font-size: 0.94rem;
  }

  .form-status.is-success {
    color: #2f6b32;
    font-weight: 700;
  }

  .honeypot-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .quick-link {
    display: inline-flex;
    width: fit-content;
    color: var(--accent);
    font-weight: 700;
  }

  .contact-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem;
    margin: 0 0 1rem;
  }

  .gallery-card {
    margin: 0;
  }

  .gallery-card :global(img) {
    width: 100%;
    height: 190px;
    object-fit: contain;
    background: var(--bg);
  }

  .map-wrap iframe {
    width: 100%;
    min-height: 310px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
