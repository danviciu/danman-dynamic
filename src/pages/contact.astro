---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getOptimizedImageUrl } from "../utils/catalog";

const phoneHref = `tel:${site.phone.replace(/\s+/g, "")}`;
const whatsappHref = `https://wa.me/${site.phone.replace(/[^\d]/g, "")}`;
const mapAddress = encodeURIComponent(site.address);
const contactImages = [
  {
    src: "/img/marchize/20251125_1245_Intrare%20Cu%20Element%20Rustice_remix_01kax9pw5fe0yvgfmt9bam4z7q.webp",
    alt: "Marchiza din lemn realizata la comanda",
  },
  {
    src: "/img/scari/20251125_1230_Scar%C4%83%20Interioar%C4%83%20Elegant%C4%83_remix_01kax8wdwvemx8szvm5e37z4ds.webp",
    alt: "Scara interioara din lemn",
  },
  {
    src: "/img/paturi/20251124_0812_Pat%20din%20Lemn_remix_01kat7qvzmfqxvt38b39mq7rj9.webp",
    alt: "Pat din lemn masiv",
  },
];
---

<BaseLayout
  title="Contact | DanMan"
  description="Cere oferta pentru mobilier la comanda. Contact direct DanMan pe WhatsApp, email sau telefon."
  canonicalPath="/contact"
  ogImage={contactImages[0].src}
>
  <section class="contact-head">
    <h1 class="section-title">Contact</h1>
    <p class="section-lead">
      Spune-ne pe scurt ce ai nevoie si iti raspundem cu o estimare orientativa, timp de executie si
      recomandari de materiale.
    </p>
  </section>

  <section class="contact-grid">
    <article class="card contact-card">
      <div class="card-content">
        <h2>Trimite detalii proiect</h2>
        <form
          id="contactForm"
          name="contact"
          method="POST"
          action="/contact?trimis=1"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="honeypot-field">
            <label for="bot-field">Nu completa acest camp.</label>
            <input id="bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
          </p>

          <label for="name">Nume</label>
          <input id="name" name="name" type="text" required />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />

          <label for="phone">Telefon</label>
          <input id="phone" name="phone" type="tel" />

          <label for="message">Mesaj</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Dimensiuni, material preferat, termen..."
            required
          ></textarea>

          <button class="cta-btn" type="submit">Trimite solicitarea</button>
          <p id="formStatus" class="form-status" aria-live="polite"></p>
        </form>
      </div>
    </article>

    <article class="card contact-card">
      <div class="card-content">
        <img
          class="contact-photo"
          src={getOptimizedImageUrl(contactImages[0].src, { width: 760, height: 400, quality: 72, fit: "cover" })}
          alt={contactImages[0].alt}
          loading="lazy"
          decoding="async"
        />
        <h2>Canale rapide</h2>
        <a class="quick-link" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a class="quick-link" href={`mailto:${site.email}`}>Email: {site.email}</a>
        <a class="quick-link" href={phoneHref}>Telefon: {site.phone}</a>
        <p>Adresa atelier: {site.address}</p>
        <p><strong>Program:</strong> Luni - Vineri, 09:00 - 18:00</p>
        <p><strong>Timp de raspuns:</strong> in medie 2-6 ore in zilele lucratoare.</p>
      </div>
    </article>
  </section>

  <section class="contact-gallery">
    {contactImages.map((item) => (
      <article class="card gallery-card">
        <img
          src={getOptimizedImageUrl(item.src, { width: 620, height: 420, quality: 72, fit: "cover" })}
          alt={item.alt}
          loading="lazy"
          decoding="async"
        />
      </article>
    ))}
  </section>

  <section class="map-wrap">
    <iframe
      title="Harta locatie DanMan"
      src={`https://www.google.com/maps?q=${mapAddress}&output=embed`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>

<script>
  const formStatus = document.getElementById("formStatus");

  if (formStatus) {
    const params = new URLSearchParams(window.location.search);
    if (params.get("trimis") === "1") {
      formStatus.textContent = "Multumim! Mesajul a fost trimis. Revenim in cel mai scurt timp.";
      formStatus.classList.add("is-success");

      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete("trimis");
      window.history.replaceState({}, "", `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
    }
  }
</script>

<style>
  .contact-head {
    margin-bottom: 1.2rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-card {
    overflow: hidden;
  }

  .contact-photo {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--line);
    margin-bottom: 0.6rem;
  }

  form {
    display: grid;
    gap: 0.55rem;
  }

  label {
    font-weight: 700;
    color: #5e4a33;
  }

  input,
  textarea {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.7rem 0.8rem;
    font: inherit;
    background: #fff;
    color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  .form-status {
    min-height: 1.6rem;
    font-size: 0.94rem;
    color: #4f483f;
  }

  .form-status.is-success {
    color: #2f6b32;
  }

  .honeypot-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .quick-link {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.4rem;
    color: var(--accent-dark);
    font-weight: 700;
  }

  .map-wrap iframe {
    width: 100%;
    min-height: 310px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .contact-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .gallery-card {
    overflow: hidden;
  }

  .gallery-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
