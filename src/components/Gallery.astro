---
import Img from "./Img.astro";
import { responsiveImage } from "../utils/images";

interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;
const slides = images.map((image) => responsiveImage(image));
---

<section class="gallery card" data-gallery>
  <button class="main-image-trigger" type="button" data-gallery-open aria-label="Deschide galeria foto">
    <Img
      src={images[0]}
      alt={title}
      class="main-image"
      priority
      sizes="(max-width: 920px) 100vw, 600px"
      id="galleryMain"
    />
  </button>

  {images.length > 1 && (
    <div class="thumbs">
      {images.map((image, index) => (
        <button
          class={index === 0 ? "thumb active" : "thumb"}
          type="button"
          data-index={index}
          aria-label={`Imaginea ${index + 1} din ${images.length}`}
        >
          <Img src={image} alt={`${title} – imaginea ${index + 1}`} sizes="120px" />
        </button>
      ))}
    </div>
  )}

  <dialog class="lightbox" aria-label={`Galerie foto: ${title}`}>
    <img class="lightbox-image" src={slides[0]?.src} alt={title} />
    <button type="button" class="lb-btn lb-close" data-action="close" aria-label="Închide galeria">&times;</button>
    {images.length > 1 && (
      <>
        <button type="button" class="lb-btn lb-prev" data-action="prev" aria-label="Imaginea anterioară">&lsaquo;</button>
        <button type="button" class="lb-btn lb-next" data-action="next" aria-label="Imaginea următoare">&rsaquo;</button>
        <p class="lb-counter" aria-live="polite"></p>
      </>
    )}
  </dialog>

  <script type="application/json" data-gallery-slides set:html={JSON.stringify(slides).replace(/</g, "\\u003c")} />
</section>

<script>
  interface Slide {
    src: string;
    srcset?: string;
  }

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const slidesEl = root.querySelector("[data-gallery-slides]");
    const slides: Slide[] = JSON.parse(slidesEl?.textContent || "[]");
    const main = root.querySelector<HTMLImageElement>("#galleryMain");
    const dialog = root.querySelector<HTMLDialogElement>("dialog.lightbox");
    const lbImage = root.querySelector<HTMLImageElement>(".lightbox-image");
    const counter = root.querySelector<HTMLElement>(".lb-counter");
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".thumb"));
    if (!main || !dialog || !lbImage || slides.length === 0) return;

    let current = 0;
    let touchStartX = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      main.src = slide.src;
      main.srcset = slide.srcset ?? "";
      lbImage.src = slide.src;
      lbImage.classList.remove("is-zoom");
      thumbs.forEach((thumb, i) => thumb.classList.toggle("active", i === current));
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    const open = (index = current) => {
      show(index);
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    };

    root.querySelector("[data-gallery-open]")?.addEventListener("click", () => open());
    thumbs.forEach((thumb, i) => thumb.addEventListener("click", () => show(i)));

    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "close" || target === dialog) dialog.close();
      else if (action === "prev") show(current - 1);
      else if (action === "next") show(current + 1);
      else if (target === lbImage) lbImage.classList.toggle("is-zoom");
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    // swipe pe telefon
    dialog.addEventListener("touchstart", (e) => (touchStartX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      const delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 50 && slides.length > 1) show(current + (delta < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .gallery {
    padding: 0.8rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .main-image-trigger {
    display: block;
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.25rem;
    cursor: zoom-in;
  }

  .main-image-trigger :global(img) {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 10px;
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 0.45rem;
  }

  .thumb {
    border: 1px solid var(--line);
    background: var(--bg);
    border-radius: 10px;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
  }

  .thumb.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-soft);
  }

  .thumb :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  .lightbox-image {
    max-width: 96vw;
    max-height: 92dvh;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 160ms ease-out;
  }

  .lightbox-image.is-zoom {
    transform: scale(2);
    cursor: zoom-out;
  }

  .lb-btn {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border-radius: 999px;
    width: 2.8rem;
    height: 2.8rem;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  .lb-close {
    top: 1rem;
    right: 1rem;
  }

  .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.9rem;
  }
</style>
