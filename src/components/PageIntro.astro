---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="page-intro">
  <h1 class="section-title">{title}</h1>
  {lead && <p class="section-lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-intro {
    margin-bottom: 1.6rem;
  }
</style>
